#!/usr/bin/env bash
# Launch Chrome with a remote-debugging port so bfa can attach (mode="attach").
# Uses a dedicated profile by default. Pass a profile dir as $2 to reuse logins —
# but it must be a NON-DEFAULT dir (e.g. a copy of your profile): Chrome 136+
# silently refuses the debug port on the live default profile, and a second Chrome
# on a dir already in use collides (one process per user-data-dir).
set -euo pipefail

PORT="${1:-9222}"
PROFILE="${2:-$HOME/.bfa/attach-profile}"
CHROME="${BFA_CHROME_PATH:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"

echo "Launching Chrome on debug port $PORT (profile: $PROFILE)"
exec "$CHROME" \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$PROFILE" \
  --no-first-run \
  --no-default-browser-check
