{
  "name": "browser-for-ai",
  "version": "0.5.0",
  "description": "CDP-native MCP server that lets an AI agent drive Chrome at full depth — deep network/console read, robust interaction, multi-session, and API-flow → runnable-code extraction",
  "type": "module",
  "license": "MIT",
  "author": "icueth",
  "homepage": "https://github.com/icueth/browser-for-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icueth/browser-for-ai.git"
  },
  "bugs": {
    "url": "https://github.com/icueth/browser-for-ai/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "chrome-devtools-protocol",
    "cdp",
    "puppeteer",
    "claude",
    "ai-agent",
    "network-inspection",
    "har"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "browser-for-ai": "dist/server.js",
    "bfa-chrome": "bfa-chrome"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.0",
    "puppeteer-core": "^24.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
